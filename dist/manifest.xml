<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
    xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:type="ContentApp">
    <Id>f3f6aab2-a9d3-4378-95a6-9526a6a62cd5</Id>
    <Version>1.0.4.0</Version>
    <ProviderName>ziclari</ProviderName>
    <DefaultLocale>en-US</DefaultLocale>
    <DisplayName DefaultValue="PowerPoint Content Add-in" />
    <Description DefaultValue="Muestra una página web dentro de PowerPoint." />
    <IconUrl DefaultValue="https://ziclari.github.io/Powerpoint-plugin/dist/assets/icon-32.png" />
    <HighResolutionIconUrl DefaultValue="https://ziclari.github.io/Powerpoint-plugin/dist/assets/icon-80.png" />
    <SupportUrl DefaultValue="https://github.com/ziclari/Powerpoint-plugin" />
    <AppDomains>
        <AppDomain>https://ziclari.github.io</AppDomain>
    </AppDomains>
    <Hosts>
        <Host Name="Presentation" />
    </Hosts>
    <Requirements>
        <Sets DefaultMinVersion="1.1">
            <Set Name="PowerPointApi" MinVersion="1.1" />
        </Sets>
    </Requirements>
    <DefaultSettings>
        <SourceLocation DefaultValue="https://ziclari.github.io/Powerpoint-plugin/dist/content.html" />
        <RequestedWidth>400</RequestedWidth>
        <RequestedHeight>400</RequestedHeight>
    </DefaultSettings>
    <Permissions>ReadWriteDocument</Permissions>
    <AllowSnapshot>true</AllowSnapshot>
</OfficeApp>
